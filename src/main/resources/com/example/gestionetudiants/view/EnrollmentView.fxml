<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionetudiants.controller.EnrollmentController"
      spacing="10"
      style="-fx-padding: 20;">

    <Label text="Gestion des Inscriptions"
           style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Rechercher:"/>
        <TextField fx:id="txtSearch" promptText="Nom d'étudiant..." prefWidth="300"/>
        <Button text="🔍 Rechercher" onAction="#handleSearch"/>
        <Button text="🔄 Effacer" onAction="#handleClear"/>
    </HBox>

    <Separator/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" prefWidth="350">
            <Label text="Informations de l'inscription"
                   style="-fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Étudiant:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbStudent" promptText="Sélectionner un étudiant"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"
                          prefWidth="200"/>

                <Label text="Classe:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbClassroom" promptText="Sélectionner une classe"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"
                          prefWidth="200"/>

                <Label text="Année:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtYear" promptText="Ex: 2024"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Date d'inscription:"
                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dateInscription"
                            GridPane.columnIndex="1" GridPane.rowIndex="3"
                            prefWidth="200"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER">
                <Button text="➕ Ajouter" onAction="#handleAdd"/>
                <Button text="✏️ Modifier" onAction="#handleUpdate"/>
                <Button text="🗑️ Supprimer" onAction="#handleDelete"/>
            </HBox>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox HBox.hgrow="ALWAYS">
            <Label text="Liste des inscriptions"
                   style="-fx-font-weight: bold;"/>
            <TableView fx:id="enrollmentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colStudent" text="Étudiant" prefWidth="200"/>
                    <TableColumn fx:id="colClassroom" text="Classe" prefWidth="150"/>
                    <TableColumn fx:id="colYear" text="Année" prefWidth="100"/>
                    <TableColumn fx:id="colDateInscription" text="Date d'inscription" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
