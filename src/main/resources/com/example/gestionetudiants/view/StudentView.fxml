<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionetudiants.controller.StudentController"
      spacing="10"
      style="-fx-padding: 20;">

    <Label text="Gestion des Étudiants"
           style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Rechercher:"/>
        <TextField fx:id="txtSearch" promptText="Nom ou prénom..." prefWidth="300"/>
        <Button text="🔍 Rechercher" onAction="#handleSearch"/>
    </HBox>

    <Separator/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" prefWidth="350">
            <Label text="Informations de l'étudiant"
                   style="-fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNom" promptText="Nom"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"
                           prefWidth="200"/>

                <Label text="Prénom:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtPrenom" promptText="Prénom"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtEmail" promptText="email@example.com"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Date de naissance:"
                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dateNaissance"
                            GridPane.columnIndex="1" GridPane.rowIndex="3"
                            prefWidth="200"/>

                <Label text="Sexe:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cbSexe" promptText="Sélectionner"
                          GridPane.columnIndex="1" GridPane.rowIndex="4"
                          prefWidth="200"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Ajouter" onAction="#handleAdd"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Modifier" onAction="#handleUpdate"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Button text="Supprimer" onAction="#handleDelete"
                        style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                <Button text="Effacer" onAction="#handleClear"/>
            </HBox>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox HBox.hgrow="ALWAYS">
            <Label text="Liste des étudiants"
                   style="-fx-font-weight: bold;"/>
            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="120"/>
                    <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="colDateNaissance" text="Date Naissance" prefWidth="120"/>
                    <TableColumn fx:id="colSexe" text="Sexe" prefWidth="60"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>